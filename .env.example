APP_ENV=local
APP_SECRET_KEY=change-this-local-secret
DATABASE_URL=sqlite:///./data/recruitment.db

# mock: 无需密钥即可完整演示；openai_compatible: 调用兼容接口
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

WECOM_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_SECONDS=900
MAX_UPLOAD_BYTES=10485760

# 页面可编辑配置首启从本文件/环境导入，之后由 data/runtime.env 持久化。
# 自定义数据目录时设置 APP_DATA_DIR；DATABASE_URL 应指向同一隔离环境。

