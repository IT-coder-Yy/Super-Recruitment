APP_ENV=local
APP_SECRET_KEY=change-this-local-secret
DATABASE_URL=sqlite:///./data/recruitment.db

# mock: 无需密钥即可完整演示；openai_compatible: 调用兼容接口
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 连接/读取分别设限，不自动重试；既有安装可在 data/runtime.env 配置。
LLM_CONNECT_TIMEOUT_SECONDS=30
LLM_READ_TIMEOUT_SECONDS=120

# 企业微信暂为部署级内部群机器人配置。
WECOM_WEBHOOK_URL=

# 部署默认邮箱：HR 未配置个人邮箱时使用。留空 SMTP_HOST 保持 Mock。
# QQ 邮箱：SMTP_HOST=smtp.qq.com，465，SSL=true。
SMTP_HOST=
SMTP_PORT=465
# 以下填写完整邮箱地址、SMTP 授权码、发件地址（可与账号相同）。
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_SECONDS=900
MAX_UPLOAD_BYTES=10485760

# 邮件网页设置只修改当前登录 HR 的 data/users/<id>/smtp.runtime.env。
# 个人配置优先；未设置时使用上述默认邮箱；个人配置失败不会回退到其他邮箱。
# 修改本文件后重启服务。SMTP 部署环境/.env 优先于旧 data/runtime.env。
# 模型和企微的网页配置仍由 data/runtime.env 持久化，首启从本文件/环境导入。
# 自定义数据目录时设置 APP_DATA_DIR；DATABASE_URL 应指向同一隔离环境。

